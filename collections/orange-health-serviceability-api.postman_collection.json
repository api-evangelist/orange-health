      "name": "Serviceability",
      "description": {
        "content": "Check whether a location is serviceable and fetch available slots.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c3b8330d-92c1-40aa-b9ae-c4a00b1f31aa",
          "name": "Fetch serviceability",
          "request": {
            "name": "Fetch serviceability",
            "description": {
              "content": "Check whether a pickup location is serviceable and, when latitude and longitude are supplied, return the available collection slots. When only a pincode is supplied, returns serviceability without slots.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "partner",
                "serviceability"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "latitude",
                  "value": "<number>",
                  "description": "Latitude of pickup location. 13.0240 for sandbox testing."
                },
                {
                  "disabled": false,
                  "key": "longitude",
                  "value": "<number>",
                  "description": "Longitude of pickup location. 77.6433 for sandbox testing."
                },
                {
                  "disabled": false,
                  "key": "request_date",
                  "value": "<date>",
                  "description": "(Required) Pickup date (YYYY-MM-DD), must be >= today."
                },
                {
                  "disabled": false,
                  "key": "pincode",
                  "value": "<string>",
                  "description": "Pincode when lat/long unavailable. 560043 for sandbox testing."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
