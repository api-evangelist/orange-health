  "info": {
    "_postman_id": "6df9d755-e0b8-40ab-a6b2-3025c65abdb5",
    "name": "Orange Health Partner Orders Serviceability API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Partner API for Orange Health Labs — a home-collection diagnostics lab serving Indian metros. Partners check serviceability, create home-collection, lab-drop-off and camp orders, track order status, reschedule/cancel/add-on to orders, and pull structured test results. Order lifecycle transitions are delivered as HMAC-signed webhooks. Derived from the published Apiary API Blueprint (Partner API Public Order Flow).\n\nContact Support:\n Name: Orange Health Integrations\n Email: integrations@orangehealth.in",
      "type": "text/plain"
    }
  }
